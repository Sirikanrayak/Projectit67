# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามต้องการก่อนรัน docker compose up
DB_NAME=projectit67
DB_USER=projectit67
DB_PASSWORD=changeme_password
DB_ROOT_PASSWORD=changeme_root_password

# พอร์ตบนเครื่อง host ที่จะ map เข้า MySQL (ค่าเริ่มต้น 3306) — ปรับได้ถ้าเครื่องมี MySQL อื่นใช้พอร์ต 3306 อยู่แล้ว
# DB_HOST_PORT=3307
